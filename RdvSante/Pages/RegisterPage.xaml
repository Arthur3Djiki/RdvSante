<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="RdvSante.Pages.RegisterPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:RdvSante.Controls"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">
    <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="48,*" Padding="8,12,16,0">
            <Button Style="{StaticResource GhostButton}" Text="←" Clicked="OnBack" />
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                <Label Text="Créer un compte" FontSize="20" Style="{StaticResource Title}" />
                <Label x:Name="SubTitle" Text="Vos informations personnelles" Style="{StaticResource Muted}" />
            </VerticalStackLayout>
        </Grid>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,12,24,24" Spacing="6">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto,Auto">
                    <Label Text="Nom" Style="{StaticResource FieldLabel}" />
                    <Label Grid.Column="1" Text="Prénom" Style="{StaticResource FieldLabel}" />
                    <Border Grid.Row="1" x:Name="NomBox" Style="{StaticResource Field}"><Entry x:Name="NomEntry" Placeholder="Votre nom" /></Border>
                    <Border Grid.Row="1" Grid.Column="1" x:Name="PrenomBox" Style="{StaticResource Field}"><Entry x:Name="PrenomEntry" Placeholder="Votre prénom" /></Border>
                    <Label Grid.Row="2" x:Name="NomMsg" IsVisible="False" />
                    <Label Grid.Row="2" Grid.Column="1" x:Name="PrenomMsg" IsVisible="False" />
                </Grid>

                <Label Text="Email" Style="{StaticResource FieldLabel}" />
                <Border x:Name="EmailBox" Style="{StaticResource Field}"><Entry x:Name="EmailEntry" Placeholder="vous@exemple.fr" Keyboard="Email" /></Border>
                <Label x:Name="EmailMsg" IsVisible="False" />

                <Label Text="Téléphone" Style="{StaticResource FieldLabel}" />
                <Border x:Name="PhoneBox" Style="{StaticResource Field}"><Entry x:Name="PhoneEntry" Placeholder="+237 6 XX XX XX XX" Keyboard="Telephone" /></Border>
                <Label x:Name="PhoneMsg" IsVisible="False" />

                <Label Text="Mot de passe" Style="{StaticResource FieldLabel}" />
                <Border x:Name="PwdBox" Style="{StaticResource Field}"><Entry x:Name="PwdEntry" Placeholder="8 caractères minimum" IsPassword="True" /></Border>
                <Label x:Name="PwdMsg" IsVisible="False" />

                <Label Text="Confirmer le mot de passe" Style="{StaticResource FieldLabel}" />
                <Border x:Name="Pwd2Box" Style="{StaticResource Field}"><Entry x:Name="Pwd2Entry" Placeholder="Répétez le mot de passe" IsPassword="True" /></Border>
                <Label x:Name="Pwd2Msg" IsVisible="False" />

                <HorizontalStackLayout Spacing="4" Margin="0,8,0,0">
                    <CheckBox x:Name="TermsBox" Color="{StaticResource Primary}" VerticalOptions="Start" />
                    <Label Text="J’accepte les conditions d’utilisation et la confidentialité." FontSize="13" WidthRequest="280" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Label x:Name="TermsMsg" IsVisible="False" />

                <Button Text="Créer mon compte" Clicked="OnCreate" Margin="0,12,0,0" />
                <Label Text="Déjà inscrit ? Se connecter" Style="{StaticResource PrimaryText}" HorizontalOptions="Center" Margin="0,8,0,0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLoginTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
