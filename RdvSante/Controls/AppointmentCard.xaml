<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="RdvSante.Controls.AppointmentCard"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Border Style="{StaticResource MintCard}">
        <VerticalStackLayout Spacing="12">
            <Grid ColumnDefinitions="52,*" ColumnSpacing="10">
                <Border Style="{StaticResource Avatar}" WidthRequest="48" HeightRequest="48">
                    <Image Source="{Binding Practitioner.Photo}" Aspect="AspectFill" />
                </Border>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                    <Label Text="{Binding Practitioner.Name}" Style="{StaticResource Bold}" />
                    <Label Text="{Binding Practitioner.Specialty}" Style="{StaticResource Muted}" />
                </VerticalStackLayout>
            </Grid>
            <Grid ColumnDefinitions="30,*">
                <Label Text="📅" FontSize="18" VerticalOptions="Start" />
                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label Text="{Binding DateLabel}" Style="{StaticResource Bold}" />
                    <Label Text="{Binding TimeLabel}" Style="{StaticResource Muted}" />
                </VerticalStackLayout>
            </Grid>
            <Grid ColumnDefinitions="30,*">
                <Label Text="🎥" FontSize="18" VerticalOptions="Start" />
                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label Text="Consultation vidéo" Style="{StaticResource Bold}" />
                    <Label Text="Le lien sera disponible dans Mes rendez-vous." Style="{StaticResource Muted}" />
                </VerticalStackLayout>
            </Grid>
            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Tarif de consultation" Style="{StaticResource Muted}" FontSize="13" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{Binding Practitioner.PriceLabel}" Style="{StaticResource Bold}" />
            </Grid>
        </VerticalStackLayout>
    </Border>
</ContentView>
